                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-credit" value="信用归还(信用 +1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E53935;endArrow=block;endFill=1;fontSize=11;" parent="1" source="receiver" target="sender" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-note" value="发送端最多发「缓冲容量」个未确认包 → 缓冲区永不溢出 → 无丢包、无需端到端重传&#xa;信用按 VL 独立、逐跳协商 → 无损且不死锁(对比 RoCE 的 PFC 逐跳反压)" style="text;html=1;fontSize=12;fontColor=#555555;align=center;" parent="1" vertex="1">
