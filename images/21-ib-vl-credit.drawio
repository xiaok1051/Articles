                </mxCell>
                <mxCell id="sender" value="发送端&#xa;每 VL 一个信用计数器&#xa;剩余信用 = 5&#xa;────────&#xa;发 1 包 → 信用 -1&#xa;信用 = 0 → 停发" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="43" y="314" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="receiver" value="接收端&#xa;接收缓冲区(容量 8)&#xa;────────&#xa;上层取走数据腾出空间&#xa;→ 发信用归还报文" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=12;" parent="1" vertex="1">
