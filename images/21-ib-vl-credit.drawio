                </mxCell>
                <mxCell id="p2-title" value="② 信用流控:发送端凭信用发送,信用 = 接收缓冲容量(初始:接收端发 8 个信用)" style="text;html=1;fontSize=14;fontStyle=1;align=left;fontColor=#1565C0;" parent="1" vertex="1">
