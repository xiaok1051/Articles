                <mxCell id="title" value="UEC 分层架构" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="90" y="20" width="250" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="sem" value="&lt;b&gt;语义层 Semantic Layer&lt;/b&gt;　【可选 · 新增】&lt;br&gt;MPI tag matching · 集合通信下沉到网卡&lt;br&gt;&lt;i&gt;对应 IB/RoCE 的上层,但把语义下沉到硬件&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;spacing=14;fontSize=13;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="trans" value="&lt;b&gt;传输层 Transport Layer = UET&lt;/b&gt;　【核心 · 重写】&lt;br&gt;可靠传输 · 乱序交付 · packet spraying · 拥塞控制&lt;br&gt;&lt;i&gt;对应 IB Transport,但不沿用 BTH,全新设计&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;spacing=14;fontSize=13;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="162" width="360" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="link" value="&lt;b&gt;链路层 Link Layer + LLR&lt;/b&gt;　【增强】&lt;br&gt;链路级重传,把丢包变得廉价&lt;br&gt;&lt;i&gt;对应 IB Link,以太网 + LLR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;spacing=14;fontSize=13;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="259" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="phy" value="&lt;b&gt;物理层 Physical Layer = IEEE 802.3&lt;/b&gt;　【复用】&lt;br&gt;标准以太网 PHY · 100G / 200G / 400G / 800G&lt;br&gt;&lt;i&gt;同 RoCE 一样用 802.3,IB 则为私有 PHY&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;spacing=14;fontSize=13;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="351" width="360" height="85" as="geometry"/>
