        <mxCell id="c2t" value="ib_write_bw · ib_read_bw（带宽）&lt;br&gt;ib_send_bw · ib_atomic_bw（带宽）&lt;br&gt;ib_write_lat 等 *_lat 系列（延迟）&lt;br&gt;qperf（快速性能基线）" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="c2">
