        <mxCell id="c1" value="IB 原生工具" style="swimlane;rounded=1;arcSize=5;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=14;startSize=34;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="64" width="350" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="c1t" value="拓扑查询：ibstat · ibnetdiscover · iblinkinfo&lt;br&gt;子网管理：opensm&lt;br&gt;SM/SA 查询：sminfo · smpquery · saquery&lt;br&gt;诊断：ibdiagnet · ibcheck* · ibping · ibtracert&lt;br&gt;计数器：perfquery&lt;br&gt;转发表：dump_lfts / dump_mfts · ibroute" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="c1">
