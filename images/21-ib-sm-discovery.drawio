<mxfile host="app.diagrams.net"><diagram id="v241qd3k-zgwb" name="Page-1"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="SM 子网发现流程" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="720" height="32" as="geometry"/></mxCell><mxCell id="3" value="① 直连探测&#10;SM 用直连路由(VL15)探测第一个邻居" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="48" width="440" height="58" as="geometry"/></mxCell><mxCell id="4" value="② 递归遍历&#10;Get(NodeInfo / PortInfo) 一层层收集拓扑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1E88E5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="132" width="440" height="58" as="geometry"/></mxCell><mxCell id="5" value="③ 分配 LID&#10;给每个端口分配唯一 16 位 LID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#1E88E5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="216" width="440" height="58" as="geometry"/></mxCell><mxCell id="6" value="④ 计算路径&#10;按拓扑算最短路径(minhop / updn / fat-tree)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64B5F6;strokeColor=#1565C0;fontSize=13;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="180" y="300" width="440" height="58" as="geometry"/></mxCell><mxCell id="7" value="⑤ 下发 LFT&#10;Set(LinearForwardingTable) 写入交换机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1565C0;fontSize=13;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="180" y="384" width="440" height="58" as="geometry"/></mxCell><mxCell id="8" value="⑥ 监听变化&#10;订阅 Trap,拓扑变化则重跑发现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E88E5;strokeColor=#0D47A1;fontSize=13;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="180" y="468" width="440" height="58" as="geometry"/></mxCell><mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;" edge="1"