<mxfile host="Electron">
    <diagram name="Page-1" id="opensm-code-trap-loop">
        <mxGraphModel dx="944" dy="744" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="540" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;fontColor=#1a1a1a;" value="源码篇 3.4：trap 触发重扫的稳态回环" vertex="1">
                    <mxGeometry height="30" width="440" x="230" y="14" as="geometry"/>
                </mxCell>
                <mxCell id="steady" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" value="&lt;b&gt;稳态：SM 停在 Master&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LFT 全部落位 · SA 常驻应答&lt;/font&gt;" vertex="1">
                    <mxGeometry height="62" width="320" x="290" y="58" as="geometry"/>
                </mxCell>
                <mxCell id="trap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;设备上报 trap（QP1 Notice）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;osm_trap_rcv_process →&lt;br&gt;trap_rcv_process_request：log_trap_info&lt;/font&gt;" vertex="1">
                    <mxGeometry height="68" width="320" x="290" y="148" as="geometry"/>
                </mxCell>
                <mxCell id="decide" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="trap ∈ {128, 144}&amp;lt;br&amp;gt;且 sweep_on_trap 开？" vertex="1">
                    <mxGeometry height="90" width="230" x="335" y="243" as="geometry"/>
                </mxCell>
                <mxCell id="noisy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" value="&lt;b&gt;trap 129 / 130 / 131 等&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;shutup_noisy_port 标记，不重扫&lt;/font&gt;" vertex="1">
                    <mxGeometry height="64" width="222" x="608" y="256" as="geometry"/>
                </mxCell>
                <mxCell id="flag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="&lt;b&gt;&lt;font color=&quot;#8b2c28&quot;&gt;force_heavy_sweep = TRUE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;osm_sm_signal(OSM_SIGNAL_SWEEP) 唤醒 sweeper&lt;/font&gt;" vertex="1">
                    <mxGeometry height="58" width="320" x="290" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="heavy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;sweeper 醒来 → do_sweep（heavy）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;重扫拓扑 → LID → 路由 → set_lft_block&lt;/font&gt;" vertex="1">
                    <mxGeometry height="58" width="320" x="290" y="444" as="geometry"/>
                </mxCell>
                <mxCell id="e1" edge="1" parent="1" source="steady" target="trap" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"/>
                <mxCell id="e2" edge="1" parent="1" source="trap" target="decide" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"/>
                <mxCell id="e3" edge="1" parent="1" source="decide" target="noisy" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"/>
                <mxCell id="e4" edge="1" parent="1" source="decide" target="flag" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"/>
                <mxCell id="e5" edge="1" parent="1" source="flag" target="heavy" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"/>
                <mxCell id="e6" edge="1" parent="1" source="noisy" target="steady" value="记录后回稳态" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#999999;exitX=0.5;exitY=0;entryX=1;entryY=0.5;"/>
                <mxCell id="e7" edge="1" parent="1" source="heavy" target="steady" value="osm_lft_rcv_process&lt;br&gt;逐块确认写回 lft" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="260" y="473"/>
                            <mxPoint x="260" y="89"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
